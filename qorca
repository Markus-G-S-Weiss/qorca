def detect_cluster():
    """
    Detect which cluster the script is running on.
    
    Detection hierarchy:
    1. CLUSTER_NAME environment variable
    2. SLURM's ClusterName configuration
    3. Fall back to default (g2)
    
    When determined via scontrol, exports CLUSTER_NAME to environment.
    
    Returns:
        tuple: (cluster_name, cluster_config)
    """    
    # Mapping of possible SLURM cluster names to our config keys
    cluster_mapping = {
        'g2': 'g2',
        'juno': 'juno',
        # Add more mappings if SLURM cluster names differ from config keys
    }
    
    # Step 1: Check environment variable first
    env_cluster_name = environ.get("CLUSTER_NAME", "").lower()
    if env_cluster_name:
        # Apply mapping if needed
        mapped_name = cluster_mapping.get(env_cluster_name, env_cluster_name)
        if mapped_name in CLUSTER_CONFIGS:
            return mapped_name, CLUSTER_CONFIGS[mapped_name]
        else:
            print(f"Warning: Environment variable CLUSTER_NAME='{env_cluster_name}' doesn't match any known cluster", 
                  file=sys.stderr)
    
    # Step 2: Try SLURM config if environment variable not set or invalid
    try:
        result = subprocess.run(
            ['scontrol', 'show', 'config'], 
            stdout=subprocess.PIPE, 
            stderr=subprocess.PIPE,
            text=True,
            check=True,
            timeout=5
        )
        
        # Find ClusterName in output
        for line in result.stdout.split('\n'):
            if line.strip().startswith('ClusterName'):
                slurm_cluster_name = line.split('=')[1].strip().lower()
                # Map the detected name
                mapped_name = cluster_mapping.get(slurm_cluster_name, slurm_cluster_name)
                
                if mapped_name in CLUSTER_CONFIGS:
                    # Set the environment variable for this process
                    environ["CLUSTER_NAME"] = mapped_name
                    print(f"Detected SLURM cluster: {slurm_cluster_name} -> mapped to: {mapped_name}", file=sys.stderr)
                    print(f"# For future runs, you can set: export CLUSTER_NAME={mapped_name}", file=sys.stderr)
                    return mapped_name, CLUSTER_CONFIGS[mapped_name]
                else:
                    print(f"Warning: Detected SLURM cluster '{slurm_cluster_name}' doesn't map to a known configuration", 
                          file=sys.stderr)
                
                break  # Exit loop after finding ClusterName line
                
    except (subprocess.SubprocessError, IndexError, TimeoutError) as e:
        print(f"Warning: Could not determine cluster from SLURM config: {e}", file=sys.stderr)
    
    # Step 3: Fallback to default
    print("Warning: Using default G2 cluster settings", file=sys.stderr)
    return "g2", CLUSTER_CONFIGS["g2"]

def read_input_file(input_path):
    """
    Read the ORCA input file.

    Args:
        input_path (Path): Path to the input file.

    Returns:
        list: Lines of the input file.

    Raises:
        SystemExit: If the input file does not exist.
    """
    if not input_path.is_file():
        print(
            f"Error: Input file '{input_path}' does not exist. "
            "Please check the file path and try again.",
            file=sys.stderr
        )
        sys.exit(1)
    lines = input_path.read_text().splitlines(keepends=True)
    return lines


def parse_pal_from_input(lines):
    """
    Parse PAL value from ORCA input file lines.

    Args:
        lines (list): Lines from the ORCA input file.

    Returns:
        int or None: The PAL value found, or None if not found.
    """
    input_text = ''.join(lines)
    # Use regex to find %pal ... end blocks, regardless of formatting
    pal_blocks = re.findall(r'%pal\s*(.*?)\s*end', input_text, re.IGNORECASE | re.DOTALL)
    for pal_block in pal_blocks:
        # Search for nprocs value within pal_block
        match = re.search(r'nprocs\s+(\d+)', pal_block, re.IGNORECASE)
        if match:
            pal_value = int(match.group(1))
            return pal_value
    # Also check for pal in '!' line
    for line in lines:
        stripped_line = line.strip()
        if stripped_line.startswith('!'):
            tokens = stripped_line[1:].strip().split()
            for token in tokens:
                match = re.match(r'pal(\d+)', token.lower())
                if match:
                    pal_value = int(match.group(1))
                    return pal_value
    return None


def adjust_pal_in_input(lines, pal_value):
    """
    Adjust the PAL value in the ORCA input file.

    If %pal block is not found and PAL is not in '!' line, it is added at the end.

    Args:
        lines (list): Lines from the ORCA input file.
        pal_value (int): The PAL value to set.

    Returns:
        tuple: (list of lines, bool indicating whether changes were made)
    """
    input_text = ''.join(lines)
    original_input_text = input_text  # Save original input
    pal_block_found = False
    pal_in_exclamation_found = False

    # First, check if there is a %pal block with various formatting
    def replace_pal_block(match):
        pal_block = match.group(0)
        new_pal_block, n_subs = re.subn(
            r'(nprocs\s+)(\d+)',
            lambda m: f"{m.group(1)}{pal_value}",
            pal_block,
            flags=re.IGNORECASE
        )
        return new_pal_block, n_subs

    def replace_pal_block_wrapper(match):
        new_pal_block, n_subs = replace_pal_block(match)
        replace_pal_block_wrapper.substitutions_made += n_subs
        return new_pal_block

    replace_pal_block_wrapper.substitutions_made = 0

    input_text = re.sub(
        r'%pal\b.*?end',
        replace_pal_block_wrapper,
        input_text,
        flags=re.IGNORECASE | re.DOTALL
    )
    if replace_pal_block_wrapper.substitutions_made > 0:
        pal_block_found = True

    # Now, check for PAL in '!' lines that contain 'pal'
    def replace_pal_in_excl(match):
        line = match.group(0)
        new_line, n_subs = re.subn(
            r'(pal)(\d+)',
            lambda m: f"{m.group(1)}{pal_value}",
            line,
            flags=re.IGNORECASE
        )
        replace_pal_in_excl.substitutions_made += n_subs
        return new_line

    replace_pal_in_excl.substitutions_made = 0

    input_text = re.sub(
        r'^!.*pal.*$', replace_pal_in_excl,
        input_text, flags=re.MULTILINE | re.IGNORECASE
    )
    if replace_pal_in_excl.substitutions_made > 0:
        pal_in_exclamation_found = True

    # If neither %pal block nor PAL in '!' line was found, add %pal block at the end
    if not pal_block_found and not pal_in_exclamation_found:
        input_text += f'\n%pal\n   nprocs {pal_value}\nend\n'
        changes_made = True
    else:
        changes_made = input_text != original_input_text

    new_lines = input_text.splitlines(True)
    return new_lines, changes_made


def handle_pal(args, lines, input_path):
    """
    Handle PAL adjustments in the input file.

    Args:
        args (argparse.Namespace): Parsed command-line arguments.
        lines (list): Lines from the input file.
        input_path (Path): Path to the input file.

    Returns:
        tuple: (int, updated lines from the input file)
    """
    # Parse pal value from input file
    input_file_pal = parse_pal_from_input(lines)

    if args.pal is not None:
        pal_value = args.pal
        new_lines, changes_made = adjust_pal_in_input(lines, pal_value)
        if changes_made:
            # Overwrite the input file in the working directory
            with input_path.open('w') as f:
                f.writelines(new_lines)
            print(
                f"Input file '{input_path}' overwritten with specified PAL value ({pal_value}).",
                file=sys.stderr
            )
            lines = new_lines
        else:
            print(
                f"PAL value in '{input_path}' is already set to {pal_value}.",
                file=sys.stderr
            )
    else:
        # Use PAL value from input file or default to 1
        pal_value = input_file_pal if input_file_pal is not None else 1

    return pal_value, lines


def parse_maxcore_from_input(lines):
    """
    Parse %maxcore value from ORCA input file lines.

    Args:
        lines (list): Lines from the ORCA input file.

    Returns:
        int or None: The maxcore value found, or None if not found.
    """
    maxcore = None
    input_text = ''.join(lines)
    match = re.search(r'%maxcore\s+(\d+)', input_text, re.IGNORECASE)
    if match:
        maxcore = int(match.group(1))
    return maxcore


def adjust_maxcore_in_input(lines, maxcore_value):
    """
    Adjust the %maxcore value in the ORCA input file.

    If %maxcore is not found, it is added at the end of the file.

    Args:
        lines (list): Lines from the ORCA input file.
        maxcore_value (int): The maxcore value to set (in MB).

    Returns:
        tuple: (list of lines, bool indicating whether changes were made)
    """
    input_text = ''.join(lines)
    original_input_text = input_text  # Save original input

    # Check if %maxcore is present and parse its value
    current_maxcore = parse_maxcore_from_input(lines)

    if current_maxcore is not None:
        if current_maxcore == maxcore_value:
            # Maxcore is already set to the desired value; no changes needed
            changes_made = False
            new_lines = lines
        else:
            # Replace the existing %maxcore value with the desired value
            input_text = re.sub(
                r'(%maxcore\s+)(\d+)',
                r'\g<1>{}'.format(maxcore_value),
                input_text,
                flags=re.IGNORECASE
            )
            changes_made = True
            new_lines = input_text.splitlines(True)
    else:
        # %maxcore not found; append it to the end
        input_text += f'\n%maxcore {maxcore_value}\n'
        changes_made = True
        new_lines = input_text.splitlines(True)

    return new_lines, changes_made


def check_memory_requirements(maxcore_value, pal_value, tasks, cpus_per_task, mem_per_cpu):
    """
    Check if total ORCA memory exceeds total SLURM memory.

    Args:
        maxcore_value (int): Maxcore value in MB.
        pal_value (int): PAL value being used.
        tasks (int): Number of tasks allocated in SLURM.
        cpus_per_task (int): Number of CPUs per task.
        mem_per_cpu (int): Memory per CPU in MB.

    Raises:
        SystemExit: If total ORCA memory exceeds total SLURM memory.
    """
    total_orca_memory = maxcore_value * pal_value  # MB
    total_slurm_memory = tasks * cpus_per_task * mem_per_cpu  # MB
    memory_usage_percent = (total_orca_memory / total_slurm_memory) * 100

    if total_orca_memory > total_slurm_memory:
        print(
            f"Error: Total ORCA memory ({total_orca_memory} MB) exceeds "
            f"total SLURM memory ({total_slurm_memory} MB).",
            file=sys.stderr
        )
        print(
            "Adjust '--maxcore', number of tasks/cpus-per-task/PAL, or %maxcore in input file to ensure total "
            "ORCA memory does not exceed total SLURM memory.",
            file=sys.stderr
        )
        sys.exit(1)
    elif memory_usage_percent > 75.0:
        print(
            f"Warning: ORCA memory usage ({total_orca_memory} MB, {memory_usage_percent:.1f}%) "
            f"exceeds 75% of allocated SLURM memory ({total_slurm_memory} MB).",
            file=sys.stderr
        )
        print(
            "Consider increasing memory allocation or reducing '--maxcore' to avoid potential memory issues.",
            file=sys.stderr
        )


def handle_maxcore(args, lines, pal_value, input_path, mem_per_cpu):
    """
    Handle maxcore adjustments in the input file.

    Args:
        args (argparse.Namespace): Parsed command-line arguments.
        lines (list): Lines from the input file.
        pal_value (int): PAL value being used.
        input_path (Path): Path to the input file.
        mem_per_cpu (int): Memory per CPU in MB.

    Returns:
        tuple: (int or None, updated lines from the input file)
    """
    # Parse maxcore value from input file
    input_file_maxcore = parse_maxcore_from_input(lines)

    if args.maxcore is not None:
        # Convert maxcore from GB to MB and apply 75% scaling
        maxcore_value = int(args.maxcore * 1024 * 0.75)  # MB

        # Check if total ORCA memory exceeds total SLURM memory
        check_memory_requirements(maxcore_value, pal_value, args.tasks, args.cpus, mem_per_cpu)

        # Adjust %maxcore in input file
        new_lines, changes_made = adjust_maxcore_in_input(lines, maxcore_value)
        if changes_made:
            # Overwrite the input file
            with input_path.open('w') as f:
                f.writelines(new_lines)
            print(
                f"Input file '{input_path}' overwritten with adjusted %maxcore value ({maxcore_value} MB).",
                file=sys.stderr
            )
            lines = new_lines
        else:
            print(
                f"%maxcore value in '{input_path}' is already set to {maxcore_value} MB.",
                file=sys.stderr
            )
    else:
        if input_file_maxcore is not None:
            maxcore_value = input_file_maxcore
            # Check if total ORCA memory exceeds total SLURM memory
            check_memory_requirements(maxcore_value, pal_value, args.tasks, args.cpus, mem_per_cpu)
            # No changes to input file; no message needed
        else:
            maxcore_value = None
            # No %maxcore set and no --maxcore provided; no message needed

    return maxcore_value, lines


def validate_resources(args, pal_value, force=False):
    """
    Validate resource allocation between PAL value and tasks.

    Args:
        args (argparse.Namespace): Parsed command-line arguments.
        pal_value (int): PAL value specified or parsed from input.
        force (bool, optional): Proceed despite mismatches if True.

    Returns:
        int: Number of tasks to allocate in SLURM.

    Raises:
        SystemExit: If mismatches are found and not forced.
    """
    tasks = args.tasks if args.tasks is not None else pal_value
    errors = []

    if pal_value != tasks:
        errors.append(
            f"Number of tasks ({tasks}) does not match PAL value ({pal_value})."
        )

    if errors and not force:
        print(
            "Error: Mismatch detected between specified tasks and PAL value:",
            file=sys.stderr
        )
        for error in errors:
            print(f"  - {error}", file=sys.stderr)
        print(
            "Use '--force' to proceed anyway, or adjust your input file or "
            "command-line arguments.",
            file=sys.stderr
        )
        sys.exit(1)
    elif errors and force:
        print("Warning: Proceeding despite mismatches:", file=sys.stderr)
        for error in errors:
            print(f"  - {error}", file=sys.stderr)

    return tasks


def handle_version_settings(args, cluster_name):
    """
    Retrieve ORCA version settings and return module load commands and executable path.

    Args:
        args (argparse.Namespace): Parsed command-line arguments.
        cluster_name (str): Name of the cluster.

    Returns:
        tuple: (list of module load commands, str of ORCA executable path)
    """
    version = args.version
    cluster_config = CLUSTER_CONFIGS.get(cluster_name, CLUSTER_CONFIGS["g2"])
    orca_versions = cluster_config["orca_versions"]
    
    if version not in orca_versions:
        print(
            f"Error: ORCA version '{version}' is not recognized for cluster '{cluster_name}'.",
            file=sys.stderr
        )
        print(
            f"Available versions for {cluster_name}: {', '.join(orca_versions.keys())}",
            file=sys.stderr
        )
        sys.exit(1)

    version_info = orca_versions[version]
    module_load_commands = version_info['module_loads']
    orca_executable = version_info['orca_executable']
    return module_load_commands, orca_executable


def generate_slurm_script(
        args, module_load_commands, orca_executable, input_path, mem_per_cpu, cluster_name
        ):
    """
    Generate the SLURM script based on provided parameters.

    Args:
        args (argparse.Namespace): Parsed command-line arguments.
        module_load_commands (list): Module load commands.
        orca_executable (str): Path to the ORCA executable.
        input_path (Path): Path to the input file.
        mem_per_cpu (int): Memory per CPU in MB.
        cluster_name (str): Name of the cluster.

    Returns:
        str: Name of the generated SLURM script file.
    """
    job_name = args.job_name or input_path.stem
    output_file = args.output or f"{input_path.stem}.out"
    error_file = args.error or f"{input_path.stem}.err"

    slurm_script = f'{job_name}.slurm'
    slurm_script_path = Path(slurm_script)
    tasks = args.tasks

    # Get configuration from cluster config
    cluster_config = CLUSTER_CONFIGS.get(cluster_name, CLUSTER_CONFIGS["g2"])
    exclude_config = cluster_config.get("exclude_nodes", {})
    partition_excludes = exclude_config.get(args.partition, [])
    scratch_base_dir = cluster_config.get("scratch_base_dir")
    
    with slurm_script_path.open('w') as f:
        # SLURM directives
        f.write('#!/bin/bash\n')
        f.write('#SBATCH --export=ALL\n')
        f.write(f'#SBATCH --job-name={job_name}\n')
        f.write(f'#SBATCH --output={error_file}\n')
        f.write(f'#SBATCH --error={error_file}\n')

        # Partition setting
        f.write(f'#SBATCH --partition={args.partition}\n')
        # Resource allocation
        f.write('#SBATCH --nodes=1\n')
        f.write(f'#SBATCH --ntasks={tasks}\n')
        f.write(f'#SBATCH --cpus-per-task={args.cpus}\n')

        # Memory per CPU - use cluster-specific value
        f.write(f'#SBATCH --mem-per-cpu={mem_per_cpu}\n')

        # Walltime
        f.write(f'#SBATCH --time={args.walltime}\n')

        # Node and exclude settings
        if args.nodename:
            f.write(f'#SBATCH --nodelist={args.nodename}\n')
        
        # Handle node exclusions - combine user-specified excludes with config excludes
        exclude_nodes = args.exclude
        if partition_excludes:
            config_excludes = ",".join(partition_excludes)
            if exclude_nodes:
                exclude_nodes = f"{exclude_nodes},{config_excludes}"
            else:
                exclude_nodes = config_excludes
                
        if exclude_nodes:
            f.write(f'#SBATCH --exclude={exclude_nodes}\n')
            
        f.write('\n# Load modules\n')
        f.write('module purge\n')
        for cmd in module_load_commands:
            f.write(f'{cmd}\n')

        f.write('\n# Set scratch directory\n')
        f.write('export ORIG=$PWD\n')
        f.write(f'export SCRATCH={scratch_base_dir}\n')
        f.write('timestamp=$(date +%Y%m%d%H%M%S)\n')
        f.write(
            'random_str=$(tr -dc a-z0-9 </dev/urandom | head -c 8)\n'
        )
        if args.scratch:
            f.write(f'export SCRATCH_DIR={args.scratch}\n')
        else:
            f.write(
                'export SCRATCH_DIR=$SCRATCH/orca_${SLURM_JOB_ID}_'
                '${timestamp}_${random_str}\n'
            )
        f.write(
            'mkdir -p $SCRATCH_DIR || { echo "Error: Failed to create '
            'scratch directory $SCRATCH_DIR"; exit 1; }\n'
        )
        f.write('\n# Copy input file to scratch directory\n')
        f.write(
            f'cp {input_path} $SCRATCH_DIR/ || '
            '{ echo "Error: Failed to copy input file"; exit 1; }\n'
        )
        f.write(
            'for file in *.xyz *.pot *.gbw *.hess; do\n'
            '  if [ -e "$file" ]; then\n'
            '    cp "$file" $SCRATCH_DIR/ || { echo "Error: Failed to '
            'copy $file"; exit 1; }\n'
            '  fi\n'
            'done\n'
        )

        f.write('\n# Change to scratch directory\n')
        f.write(
            'cd $SCRATCH_DIR || { echo "Error: Failed to change '
            'directory"; exit 1; }\n'
        )

        f.write('\n# Start ORCA job\n')
        f.write('echo "Starting ORCA job with SLURM job ID: $SLURM_JOB_ID"\n')
        f.write('echo "Running on host $(hostname)"\n')
        f.write('echo "Time is $(date)"\n')
        f.write('echo "Directory is $ORIG"\n')
        f.write('echo "SCRATCH_DIR is set to $SCRATCH_DIR"\n')
        f.write('echo "Cluster: $CLUSTER_NAME"\n')
        f.write('\n# Record start time\n')
        f.write('start_time=$(date +%s)\n')

        f.write('\n# Run ORCA job\n')
        f.write('export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK\n')
        f.write(f'echo $PWD\n')
        f.write('\n')
        # Run ORCA command
        f.write(
            f'{orca_executable} {input_path.name} > $ORIG/{output_file} '
            '|| { echo "Error: ORCA execution failed."; exit 1; }\n'
        )

        f.write('\n# Record end time\n')
        f.write('end_time=$(date +%s)\n')
        f.write('elapsed=$((end_time - start_time))\n')
        f.write('echo "ORCA job finished at $(date)"\n')
        f.write('echo "Elapsed time: $elapsed seconds"\n')

        f.write('\n# Copy output files back to submit directory\n')
        if args.save_all:
            f.write(
                'cp -R * $ORIG/ || { echo "Error: Failed to copy files '
                'back"; exit 1; }\n'
            )
        else:
            f.write(
                'for file in *.xyz *.pot *.gbw *.out *.hess *txt; do\n'
                '  if [ -f "$file" ]; then\n'
                '    cp "$file" $ORIG/ || { echo "Error: Failed to '
                'copy $file"; exit 1; }\n'
                '  fi\n'
                'done\n'
            )

        # Clean up scratch directory
        if not args.save_scratch:
            f.write('\n# Clean up scratch directory\n')
            f.write(
                'rm -rf $SCRATCH_DIR || { echo "Warning: Failed to '
                'remove scratch directory"; }\n'
            )
        else:
            f.write(
                'echo "Not deleting scratch directory due to '
                '--save-scratch option"\n'
            )

    return slurm_script


def submit_job(slurm_script, args):
    """
    Submit the job using sbatch and handle the output.

    Args:
        slurm_script (str): Name of the SLURM script file.
        args (argparse.Namespace): Parsed command-line arguments.

    Raises:
        SystemExit: If job submission fails.
    """
    if args.dryrun:
        print(f"Dry run: SLURM script written to {slurm_script}")
    else:
        # Submit the job
        cmd = ['sbatch', str(slurm_script)]
        try:
            result = subprocess.run(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                universal_newlines=True,
                check=True
            )
            # Parse job ID from output
            job_id = None
            for line in result.stdout.strip().split('\n'):
                if 'Submitted batch job' in line:
                    job_id = line.strip().split()[-1]
                    break
            if job_id:
                print(f'Submitted job {job_id}')
            else:
                print(
                    'Error: Failed to parse job ID from sbatch output.',
                    file=sys.stderr
                )
                sys.exit(1)
        except subprocess.CalledProcessError as e:
            print(
                f"Error: Failed to submit job. sbatch returned an error:\n"
                f"{e.stderr}",
                file=sys.stderr
            )
            sys.exit(1)
    
        if not args.save_slurm:
            # Clean up the SLURM script
            slurm_script_path = Path(slurm_script)
            if slurm_script_path.exists():
                slurm_script_path.unlink()


def main():
    """Main function to parse arguments and run the ORCA job submission."""
    args, cluster_name = parse_arguments()
    
    # Get cluster config
    _, cluster_config = detect_cluster()
    # Use user-provided mem-per-cpu if specified, otherwise use cluster default
    mem_per_cpu = getattr(args, 'mem_per_cpu', None) or cluster_config["mem_per_cpu"]
    
    input_path = Path(args.input_file)
    lines = read_input_file(input_path)

    # Handle PAL adjustments
    pal_value, lines = handle_pal(args, lines, input_path)

    # Validate resources and set tasks
    args.tasks = validate_resources(args, pal_value, force=args.force)

    # Handle maxcore adjustments
    maxcore_value, lines = handle_maxcore(args, lines, pal_value, input_path, mem_per_cpu)

    # Retrieve ORCA version settings
    module_load_commands, orca_executable = handle_version_settings(args, cluster_name)

    # Generate SLURM script
    slurm_script = generate_slurm_script(
        args, module_load_commands, orca_executable, input_path, mem_per_cpu, cluster_name
    )

    # Submit the job
    submit_job(slurm_script, args)


if __name__ == '__main__':
    main()
